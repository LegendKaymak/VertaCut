{
  "name": "VertaCut: yayından dikey klip",
  "short_name": "VertaCut",
  "description": "Uzun yayın videolarından altyazılı 9:16 dikey klipler çıkar. Video tarayıcından hiç çıkmaz.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#141012",
  "theme_color": "#141012",
  "lang": "tr",
  "categories": ["video", "productivity", "entertainment"],
  "icons": [
    { "src": "icons/icon-192.png?v=3", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png?v=3", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/maskable-512.png?v=3", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg?v=3", "sizes": "any", "type": "image/svg+xml" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "video/*": [".mp4", ".mov", ".webm", ".mkv", ".m4v"] }
    }
  ]
}
